# Copy to .env and fill in. .env is gitignored — never commit real values.
# These are read by the main process at startup and take precedence over
# anything saved through the app's own setup forms.

# Auth0 → Applications → your Native app → Settings.
# Allowed Callback URLs must contain http://127.0.0.1:47823/callback
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=

# Google Cloud → APIs & Services → Credentials → OAuth client (Desktop app).
# A desktop client secret is not confidential (Google's docs say so; the flow
# is protected by PKCE), but keep it out of version control anyway.
GOOGLE_OAUTH_CLIENT_ID=.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: local OrioSearch instance for the agent's web_search tool.
# ORIOSEARCH_URL=http://localhost:8005
